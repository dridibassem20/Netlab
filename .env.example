# Copy this file to .env.local and fill in real values.
# NOTE: the Supabase SECRET key must never be placed in this project.
# All privileged writes go through RLS policies checked against profiles.role.

# Supabase project URL (Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Publishable / anon key (Dashboard -> Project Settings -> API keys)
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_YOUR_KEY_HERE

# Public site URL (used for canonical links + Open Graph). e.g. https://netlab.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
